<%- include("../layouts/main", { title, body: `
  <h1 class="h1">${title}</h1>
 <p class="sub">${isEdit ? "Edit movie data." : "Add a new movie."}</p>


  <div class="hr"></div>

  ${errors.length > 0 ? `
    <div class="alert">
      <ul>
        ${errors.map(e => `<li>${e}</li>`).join("")}
      </ul>
    </div>
    <div style="height:12px;"></div>
  ` : ""}

  <form class="form" method="POST" action="${isEdit ? `/movies/${values.id}/edit` : "/movies"}">
    <div class="field">
      <label>Title</label>
      <input class="input" type="text" name="title" value="${values.title || ""}" required />
    </div>

    <div class="field">
      <label>Description</label>
      <textarea class="textarea" name="description">${values.description || ""}</textarea>
    </div>

    <div class="field">
      <label>Year</label>
      <input class="input" type="number" name="year" value="${values.year || ""}" required />
    </div>

    <div class="field">
      <label>Image URL (optional)</label>
      <input class="input" type="url" name="imageUrl" value="${values.imageUrl || ""}" placeholder="https://..." />
    </div>

    <div style="display:flex; gap:10px; flex-wrap:wrap;">
      <button class="btn btn-primary" type="submit">${isEdit ? "Update" : "Save"}</button>
      <a class="btn" href="/movies">Cancel</a>
    </div>
  </form>
` }) %>
