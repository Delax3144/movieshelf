  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title><%= title %></title>
  <link rel="stylesheet" href="/public/css/styles.css" />
</head>
<body>

  <header class="navbar">
    <div class="container nav-inner">
      <div class="brand">
        <a href="/" class="brand">MovieShelf</a>
        <span class="badge">Andrei Lahutsik</span>
      </div>

      <nav class="nav-links">
